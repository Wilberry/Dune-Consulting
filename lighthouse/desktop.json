{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/contact",
        "http://127.0.0.1:3200/services/event-safety-management",
        "http://127.0.0.1:3200/portfolio"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouse/desktop" }
  }
}
