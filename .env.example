# Public values are embedded in the browser bundle. Do not place secrets here.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
# Optional preview-only client review notice. Leave false or unset in production.
NEXT_PUBLIC_REVIEW_MODE=false

# Cloudflare Turnstile public widget key. Use Cloudflare's official test key locally/E2E.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase public configuration. The publishable key is safe for browser use when RLS is configured correctly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only privileged key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional legacy-key fallbacks for older Supabase projects only.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile server-side verification secret. Never expose this with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# Server-only email delivery configuration. Never expose these with NEXT_PUBLIC_.
CONTACT_RECIPIENT_EMAIL=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Newsletter delivery uses Resend Contacts + Segments + Broadcasts.
# NEWSLETTER_FROM_EMAIL may include a friendly name, for example:
# Dune Consulting <insights@duneconsult.ng>
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_SEGMENT_ID=
# Webhook signing secret from the Resend webhook details page.
RESEND_WEBHOOK_SECRET=

# Preview email is blocked unless this server-only flag is deliberately enabled.
ENABLE_PREVIEW_EMAIL_DELIVERY=false
